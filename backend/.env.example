# SWUMKT backend environment — copy to backend/.env and fill in.
# server.py loads backend/.env with python-dotenv (real env vars win).
# NO real secrets in this file.

# ---- Database (required) ---------------------------------------------------
MONGO_URL=mongodb://localhost:27017
DB_NAME=swumkt

# ---- Auth (required) -------------------------------------------------------
# Random 32+ chars. The server refuses to start without it.
JWT_SECRET=change-me-to-a-long-random-string
# Throwaway local runs only: start with a publicly-known JWT secret instead.
# ALLOW_INSECURE_JWT_SECRET=1

# Google sign-in (optional; Google button does nothing without them)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-host/auth/google/callback

# ---- HTTP ------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
CORS_ORIGINS=*
# Public URL of the frontend (used in links the conjoint module generates).
FRONTEND_URL=http://localhost:3000
# Reported by GET /api/health.
APP_VERSION=2026.11

# ---- LLM / object storage --------------------------------------------------
# Emergent universal key: used by emergentintegrations (all system-LLM calls,
# image generation) AND by lib/object_storage.py (uploaded images).
EMERGENT_LLM_KEY=
# System-LLM policy default when no policy is stored in Mongo
# (platform_settings {id:"llm"}). Default OFF; "on" lets the system LLM run
# until an admin stores a policy. See memory/LLM_EXTERNAL_CONTRACT.md.
# SYSTEM_LLM_DEFAULT=on

# ---- Web push (required: notification_service refuses to import without) ---
# Generate a P-256 pair, e.g. `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# ---- Tooling (not read by the server) --------------------------------------
# scripts/sitectl.py: target instance + credential (prefer an API key minted
# with scripts/mint_api_key.py).
# SWUMKT_API=https://your-host
# SWUMKT_API_KEY=swk_...
# SWUMKT_TOKEN=
# Integration tests that hit a running server:
# REACT_APP_BACKEND_URL=http://localhost:8001
# SWUMKT_ADMIN_EMAIL=admin@swu.ac.th
# SWUMKT_ADMIN_PW=
# scripts/dev_sim.py (mongomock + fake LLM local run):
# DEV_SIM_PORT=18090
# DEV_SIM_DB_NAME=swumkt_sim
