# SWUMKT frontend environment — copy to frontend/.env (CRA reads it at BUILD / dev-server start).
# NO secrets here: everything with a REACT_APP_ prefix is compiled into the public JS bundle.

# ---- Backend URL (required) ------------------------------------------------
# Origin of the FastAPI backend, no trailing slash and no "/api" (the code appends it).
# Baked in at build time: after changing it you must rebuild (and clear
# node_modules/.cache if the old URL keeps showing up).
# If left empty, a few older pages fall back to a hard-coded preview host, so always set it.
#   local dev (backend on :8001):   http://localhost:8001
#   dev_sim.py on :18090:           http://localhost:18090
#   production, same origin:        https://swumkt.org
REACT_APP_BACKEND_URL=http://localhost:8001

# ---- Dev-server / build toggles (optional, all default off) ------------------
# Turn hot reload off (useful behind some proxies):
# DISABLE_HOT_RELOAD=true
# Websocket port the dev server advertises when served behind HTTPS (e.g. 443):
# WDS_SOCKET_PORT=3000
# Visual-edit babel plugin and webpack health endpoints (craco.config.js):
# REACT_APP_ENABLE_VISUAL_EDITS=true
# ENABLE_HEALTH_CHECK=true
